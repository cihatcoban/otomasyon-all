# ============================================================================
# KEYSTONE n8n OTOMASYON PLATFORMU - ORTAM DEĞİŞKENLERİ (.env.example)
# Kullanım: cp .env.example .env komutunu çalıştırıp anahtarlarınızı girin.
# ============================================================================

# --- Temel n8n & Sunucu Ayarları ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Istanbul
TZ=Europe/Istanbul

# En az 32 karakterli rastgele bir şifreleme anahtarı belirleyin (Credential güvenliği için zorunludur)
N8N_ENCRYPTION_KEY=keystone-super-secret-encryption-key-32ch

# --- PostgreSQL Veritabanı Ayarları ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_keystone_secret

# --- Veri Saklama (Execution Pruning) Bütçesi ---
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# --- Keystone Core & Güvenlik Değişkenleri ---
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
WEBHOOK_HMAC_SECRET=replace-with-strong-hmac-sha256-secret
GITHUB_BACKUP_REPO=kullanici-adi/n8n-workflow-backups
GITHUB_TOKEN=ghp_your_github_personal_access_token

# --- AI / LLM Sağlayıcı Anahtarları (İsteğe Bağlı Ortam Değişkeni Erişimi) ---
OPENAI_API_KEY=sk-proj-your-openai-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-google-gemini-key
PINTEREST_ACCESS_TOKEN=pina_your_pinterest_access_token
