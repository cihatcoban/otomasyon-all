    {
      "id": "f6f2ea95-6690-408b-ad79-1ec6bf4ae70d",
      "name": "Webhook Gateway Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        100
      ],
      "parameters": {
        "color": 6,
        "width": 460,
        "height": 200,
        "content": "## Keystone Enterprise Webhook Gateway\n**Pillar:** *Constraint-Driven API Contract & Security (`/spec`, `/secure`)*\n- Gelen webhook isteklerinde `X-Signature-256` HMAC-SHA256 imzasını ve zaman damgası (Replay Attack) penceresini doğrular.\n- Geçersiz imzaları RFC 7807 Problem Details formatında `401 Unauthorized` ile reddeder."
      }
    },
    {
      "id": "14292987-d416-4849-a46d-205cc4a459ff",
      "name": "Incoming Protected Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        360
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "keystone-secure-ingest",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "f5a6c19c-b60b-41f6-a1be-1af1da9a5c7e",
      "name": "Verify HMAC-SHA256 & Replay Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        360
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first()?.json || {};\nconst headers = item.headers || {};\nconst bodyObj = item.body || {};\nconst secret = $env.WEBHOOK_HMAC_SECRET || 'change-me-in-env';\n\nconst signatureHeader = String(headers['x-signature-256'] || headers['x-hub-signature-256'] || '');\nconst rawBody = JSON.stringify(bodyObj);\nconst expectedSig = 'sha256=' + crypto.createHmac('sha256', secret).update(rawBody).digest('hex');\n\nlet valid = false;\nif (signatureHeader.length === expectedSig.length) {\n  valid = crypto.timingSafeEqual(Buffer.from(signatureHeader), Buffer.from(expectedSig));\n}\n\nreturn [{\n  json: {\n    authenticated: valid,\n    idempotency_key: headers['x-idempotency-key'] || crypto.createHash('md5').update(rawBody).digest('hex'),\n    payload: bodyObj\n  }\n}];"
      }
    },
    {
      "id": "fe17da27-56f0-4cad-a26d-786e2ca4c6b1",
      "name": "Signature Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        360
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
