      "id": "b0c885aa-f3e0-40b4-a83a-b12e6e166320"
    },
    {
      "name": "Google Perspective",
      "type": "n8n-nodes-base.googlePerspective",
      "position": [
        800,
        300
      ],
      "parameters": {
        "text": "={{$json[\"message\"][\"text\"]}}",
        "options": {
          "languages": "en"
