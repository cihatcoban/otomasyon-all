    },
    {
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "position": [
        1000,
        300
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json[\"attributeScores\"][\"PROFANITY\"][\"summaryScore\"][\"value\"]}}",
              "value2": 0.7,
              "operation": "larger"
            }
          ]
        }
      },
      "typeVersion": 1,
      "id": "d768392c-d6ed-4f15-aea5-06f711460a54"
    },
    {
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
