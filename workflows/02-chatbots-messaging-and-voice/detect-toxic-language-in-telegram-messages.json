{
  "id": "ee6db4d1-a4cc-4c72-acdf-efcfdafc85a0",
  "name": "Detect toxic language in Telegram messages",
  "active": false,
  "nodes": [
    {
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "position": [
        600,
